<Window x:Class="QRGen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:QRGen.Controls"
        Title="QRGen — QR ve Barkod Oluşturucu"
        Width="1220" Height="820" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Icon="pack://application:,,,/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <Grid Margin="22,14,22,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/app.ico" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="QRGen" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="QR kod ve barkod oluşturucu" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Tema" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ComboBox x:Name="cmbTheme" Width="130" SelectedIndex="0">
                    <ComboBoxItem Content="Sistem" Tag="System"/>
                    <ComboBoxItem Content="Açık" Tag="Light"/>
                    <ComboBoxItem Content="Koyu" Tag="Dark"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TabControl x:Name="tabs" Margin="16,0,6,16">
                <!-- ================= İÇERİK ================= -->
                <TabItem Header="İçerik">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                        <StackPanel Margin="2,10,4,10">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Kod türü" Style="{StaticResource SectionTitle}"/>
                                    <ComboBox x:Name="cmbType"/>
                                    <StackPanel x:Name="pnlContentType">
                                        <TextBlock Text="İçerik tipi" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="cmbContentType"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Veri" Style="{StaticResource SectionTitle}"/>

                                    <StackPanel x:Name="pnlText">
                                        <TextBox x:Name="txtText" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="220" VerticalScrollBarVisibility="Auto" Text="https://example.com"/>
                                        <TextBlock x:Name="txtTypeHint" Style="{StaticResource Hint}"/>
                                    </StackPanel>

                                    <StackPanel x:Name="pnlUrl">
                                        <TextBlock Text="Web adresi" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtUrl" Text="https://example.com"/>
                                    </StackPanel>

                                    <StackPanel x:Name="pnlWifi">
                                        <TextBlock Text="Ağ adı (SSID)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtSsid"/>
                                        <TextBlock Text="Şifre" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtWifiPass"/>
                                        <TextBlock Text="Güvenlik" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="cmbWifiSec" SelectedIndex="0">
                                            <ComboBoxItem Content="WPA / WPA2" Tag="WPA"/>
                                            <ComboBoxItem Content="WPA3 (SAE)" Tag="SAE"/>
                                            <ComboBoxItem Content="WEP" Tag="WEP"/>
                                            <ComboBoxItem Content="Şifresiz" Tag="nopass"/>
                                        </ComboBox>
                                        <CheckBox x:Name="chkWifiHidden" Content="Gizli ağ" Margin="0,10,0,0"/>
                                    </StackPanel>

                                    <StackPanel x:Name="pnlVCard">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Ad" Style="{StaticResource FieldLabel}"/><TextBox x:Name="txtFirst"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="Soyad" Style="{StaticResource FieldLabel}"/><TextBox x:Name="txtLast"/></StackPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Kurum" Style="{StaticResource FieldLabel}"/><TextBox x:Name="txtOrg"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="Unvan" Style="{StaticResource FieldLabel}"/><TextBox x:Name="txtTitle"/></StackPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Telefon (iş)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="txtPhone"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="Cep telefonu" Style="{StaticResource FieldLabel}"/><TextBox x:Name="txtMobile"/></StackPanel>
                                        </Grid>
                                        <TextBlock Text="E-posta" Style="{StaticResource FieldLabel}"/><TextBox x:Name="txtEmail"/>
                                        <TextBlock Text="Web sitesi" Style="{StaticResource FieldLabel}"/><TextBox x:Name="txtWeb"/>
                                        <TextBlock Text="Adres" Style="{StaticResource FieldLabel}"/><TextBox x:Name="txtStreet"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="90"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Şehir" Style="{StaticResource FieldLabel}"/><TextBox x:Name="txtCity"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="Posta kodu" Style="{StaticResource FieldLabel}"/><TextBox x:Name="txtZip"/></StackPanel>
                                            <StackPanel Grid.Column="4"><TextBlock Text="Ülke" Style="{StaticResource FieldLabel}"/><TextBox x:Name="txtCountry"/></StackPanel>
                                        </Grid>
                                        <TextBlock Text="Not" Style="{StaticResource FieldLabel}"/><TextBox x:Name="txtNote"/>
                                    </StackPanel>

                                    <StackPanel x:Name="pnlEmail">
                                        <TextBlock Text="Alıcı" Style="{StaticResource FieldLabel}"/><TextBox x:Name="txtMailTo"/>
                                        <TextBlock Text="Konu" Style="{StaticResource FieldLabel}"/><TextBox x:Name="txtMailSubject"/>
                                        <TextBlock Text="Mesaj" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtMailBody" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"/>
                                    </StackPanel>

                                    <StackPanel x:Name="pnlSms">
                                        <TextBlock Text="Telefon numarası" Style="{StaticResource FieldLabel}"/><TextBox x:Name="txtSmsNumber"/>
                                        <TextBlock Text="Mesaj" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtSmsMsg" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"/>
                                    </StackPanel>

                                    <StackPanel x:Name="pnlPhone">
                                        <TextBlock Text="Telefon numarası" Style="{StaticResource FieldLabel}"/><TextBox x:Name="txtPhoneNum" Text="+90 "/>
                                    </StackPanel>

                                    <StackPanel x:Name="pnlGeo">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Enlem" Style="{StaticResource FieldLabel}"/><TextBox x:Name="txtLat" Text="41.0082"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="Boylam" Style="{StaticResource FieldLabel}"/><TextBox x:Name="txtLon" Text="28.9784"/></StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel x:Name="pnlEvent">
                                        <TextBlock Text="Etkinlik adı" Style="{StaticResource FieldLabel}"/><TextBox x:Name="txtEvTitle"/>
                                        <TextBlock Text="Konum" Style="{StaticResource FieldLabel}"/><TextBox x:Name="txtEvLoc"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Başlangıç" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="dpStart"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="Saat" Style="{StaticResource FieldLabel}"/><TextBox x:Name="txtStartTime" Text="09:00"/></StackPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Bitiş" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="dpEnd"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="Saat" Style="{StaticResource FieldLabel}"/><TextBox x:Name="txtEndTime" Text="10:00"/></StackPanel>
                                        </Grid>
                                        <CheckBox x:Name="chkAllDay" Content="Tüm gün" Margin="0,10,0,0"/>
                                        <TextBlock Text="Açıklama" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtEvDesc" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Kod ayarları -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Kod ayarları" Style="{StaticResource SectionTitle}"/>

                                    <StackPanel x:Name="pnlQrSettings">
                                        <TextBlock Text="Hata düzeltme seviyesi" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="cmbEcc" SelectedIndex="1">
                                            <ComboBoxItem Content="L — Düşük (%7 kurtarma)" Tag="L"/>
                                            <ComboBoxItem Content="M — Orta (%15 kurtarma)" Tag="M"/>
                                            <ComboBoxItem Content="Q — Yüksek (%25 kurtarma)" Tag="Q"/>
                                            <ComboBoxItem Content="H — En yüksek (%30 kurtarma)" Tag="H"/>
                                        </ComboBox>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Sürüm (boyut)" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="cmbVersion"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="Maske deseni" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="cmbMask"/></StackPanel>
                                        </Grid>
                                        <TextBlock Text="Karakter kodlaması" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="cmbCharset" SelectedIndex="0">
                                            <ComboBoxItem Content="UTF-8 (önerilen)" Tag="UTF-8"/>
                                            <ComboBoxItem Content="ISO-8859-1 (Latin-1)" Tag="ISO-8859-1"/>
                                            <ComboBoxItem Content="ISO-8859-9 (Türkçe)" Tag="ISO-8859-9"/>
                                            <ComboBoxItem Content="Shift_JIS" Tag="Shift_JIS"/>
                                        </ComboBox>
                                        <CheckBox x:Name="chkEci" Content="ECI başlığı ekle (Türkçe karakter uyumu)" IsChecked="True" Margin="0,10,0,0"/>
                                    </StackPanel>

                                    <StackPanel x:Name="pnlDmSettings">
                                        <TextBlock Text="Sembol şekli" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="cmbDmShape" SelectedIndex="0">
                                            <ComboBoxItem Content="Otomatik"/>
                                            <ComboBoxItem Content="Kare"/>
                                            <ComboBoxItem Content="Dikdörtgen"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel x:Name="pnlPdfSettings">
                                        <TextBlock Text="Hata düzeltme seviyesi (0–8)" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="cmbPdfEcc"/>
                                        <CheckBox x:Name="chkPdfCompact" Content="Kompakt PDF417" Margin="0,10,0,0"/>
                                    </StackPanel>

                                    <StackPanel x:Name="pnlAztecSettings">
                                        <TextBlock Style="{StaticResource FieldLabel}">
                                            <Run Text="Hata düzeltme: %"/><Run Text="{Binding Value, ElementName=sldAztecEcc, StringFormat=0}"/>
                                        </TextBlock>
                                        <Slider x:Name="sldAztecEcc" Minimum="5" Maximum="90" Value="33" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                    </StackPanel>

                                    <StackPanel x:Name="pnl1DSettings">
                                        <TextBlock Style="{StaticResource FieldLabel}">
                                            <Run Text="Çubuk yüksekliği: genişliğin %"/><Run Text="{Binding Value, ElementName=sldBarHeight, StringFormat=0}"/>
                                        </TextBlock>
                                        <Slider x:Name="sldBarHeight" Minimum="10" Maximum="100" Value="35" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                        <CheckBox x:Name="chkShowText" Content="Okunabilir metni göster" IsChecked="True" Margin="0,8,0,0"/>
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource FieldLabel}">
                                        <Run Text="Sessiz bölge (kenar boşluğu): "/><Run Text="{Binding Value, ElementName=sldMargin, StringFormat=0}"/><Run Text=" modül"/>
                                    </TextBlock>
                                    <Slider x:Name="sldMargin" Minimum="0" Maximum="20" Value="4" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ================= STİL ================= -->
                <TabItem Header="Stil">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                        <StackPanel Margin="2,10,4,10">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Hazır temalar" Style="{StaticResource SectionTitle}"/>
                                    <WrapPanel x:Name="pnlPresets"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Şekiller" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Modül stili" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cmbModule"/>
                                    <TextBlock Style="{StaticResource FieldLabel}">
                                        <Run Text="Modül boyutu: %"/><Run Text="{Binding Value, ElementName=sldModuleScale, StringFormat=0}"/>
                                    </TextBlock>
                                    <Slider x:Name="sldModuleScale" Minimum="40" Maximum="100" Value="90" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                    <StackPanel x:Name="pnlEyeStyles">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Göz çerçevesi" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="cmbEyeFrame"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="Göz merkezi" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="cmbEyeBall"/></StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Renkler" Style="{StaticResource SectionTitle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Ön plan" Style="{StaticResource FieldLabel}"/><c:ColorPicker x:Name="cpFg1" Color="Black"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Arka plan" Style="{StaticResource FieldLabel}"/><c:ColorPicker x:Name="cpBg" Color="White"/></StackPanel>
                                    </Grid>
                                    <CheckBox x:Name="chkTransparent" Content="Şeffaf arka plan" Margin="0,10,0,0"/>
                                    <CheckBox x:Name="chkGradient" Content="Gradyan (renk geçişi) kullan" Margin="0,6,0,0"/>
                                    <Grid x:Name="pnlGradient">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="İkinci renk" Style="{StaticResource FieldLabel}"/><c:ColorPicker x:Name="cpFg2" Color="#2563EB"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Yön" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="cmbGradient"/></StackPanel>
                                    </Grid>
                                    <StackPanel x:Name="pnlEyeColors">
                                        <CheckBox x:Name="chkCustomEyes" Content="Gözler için özel renk" Margin="0,10,0,0"/>
                                        <Grid x:Name="pnlEyeColorPickers">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Çerçeve rengi" Style="{StaticResource FieldLabel}"/><c:ColorPicker x:Name="cpEyeFrame" Color="Black"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="Merkez rengi" Style="{StaticResource FieldLabel}"/><c:ColorPicker x:Name="cpEyeBall" Color="Black"/></StackPanel>
                                        </Grid>
                                    </StackPanel>
                                    <Button x:Name="btnSwap" Content="⇅  Ön plan / arka plan renklerini değiştir" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Alt yazı" Style="{StaticResource SectionTitle}"/>
                                    <TextBox x:Name="txtCaption" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40"/>
                                    <TextBlock Text="Kodun altına eklenecek metin (ör. “Beni tara”). Boş bırakılabilir." Style="{StaticResource Hint}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Yazı tipi" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="cmbFont" IsEditable="False"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Renk" Style="{StaticResource FieldLabel}"/><c:ColorPicker x:Name="cpText" Color="Black"/></StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource FieldLabel}">
                                        <Run Text="Yazı boyutu: kod genişliğinin %"/><Run Text="{Binding Value, ElementName=sldFont, StringFormat=0.0}"/>
                                    </TextBlock>
                                    <Slider x:Name="sldFont" Minimum="3" Maximum="20" Value="8" SmallChange="0.5" IsSnapToTickEnabled="True" TickFrequency="0.5"/>
                                    <CheckBox x:Name="chkBold" Content="Kalın" IsChecked="True" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Stil ön ayarları" Style="{StaticResource SectionTitle}"/>
                                    <WrapPanel>
                                        <Button x:Name="btnSaveStyle" Content="Stili kaydet…" Margin="0,0,8,0"/>
                                        <Button x:Name="btnLoadStyle" Content="Stil yükle…" Margin="0,0,8,0"/>
                                        <Button x:Name="btnResetStyle" Content="Sıfırla"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ================= LOGO ================= -->
                <TabItem Header="Logo">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                        <StackPanel Margin="2,10,4,10">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Ortaya logo ekle" Style="{StaticResource SectionTitle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Border x:Name="logoThumbFrame" Width="96" Height="96" CornerRadius="8" BorderThickness="1"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                            <Grid>
                                                <TextBlock x:Name="txtNoLogo" Text="Logo yok" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <Image x:Name="imgLogoThumb" Margin="8" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Button x:Name="btnLogo" Content="Görsel seç…" HorizontalAlignment="Stretch" Style="{DynamicResource AccentButtonStyle}"/>
                                            <Button x:Name="btnLogoRemove" Content="Logoyu kaldır" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                                            <TextBlock Text="PNG, JPG, BMP, GIF, TIFF, ICO. Görseli pencereye sürükleyip bırakabilirsiniz." Style="{StaticResource Hint}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,4">
                                        <Run Text="Logo boyutu: kodun %"/><Run Text="{Binding Value, ElementName=sldLogoSize, StringFormat=0}"/>
                                    </TextBlock>
                                    <Slider x:Name="sldLogoSize" Minimum="8" Maximum="35" Value="22" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                    <TextBlock Style="{StaticResource FieldLabel}">
                                        <Run Text="Logo çevresi boşluk: "/><Run Text="{Binding Value, ElementName=sldLogoPad, StringFormat=0.0}"/><Run Text=" modül"/>
                                    </TextBlock>
                                    <Slider x:Name="sldLogoPad" Minimum="0" Maximum="4" Value="1" IsSnapToTickEnabled="True" TickFrequency="0.25"/>
                                    <TextBlock Text="Logo arka planı" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cmbLogoBg" SelectedIndex="2">
                                        <ComboBoxItem Content="Yok"/>
                                        <ComboBoxItem Content="Kare"/>
                                        <ComboBoxItem Content="Yuvarlatılmış kare"/>
                                        <ComboBoxItem Content="Daire"/>
                                    </ComboBox>
                                    <CheckBox x:Name="chkLogoClear" Content="Logonun arkasındaki modülleri temizle" IsChecked="True" Margin="0,10,0,0"/>
                                    <CheckBox x:Name="chkLogoAutoH" Content="Logo eklenince hata düzeltmeyi H yap" IsChecked="True" Margin="0,6,0,0"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="İpucu: Logo, kodun bir kısmını kapatır. Okunabilirlik için H (%30) hata düzeltme seviyesi ve %25'in altında logo boyutu önerilir. Önizlemenin altındaki doğrulama göstergesini takip edin."/>
                                    <TextBlock x:Name="txtLogoNot2D" Style="{StaticResource Hint}" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="Logo yalnızca 2B kodlarda (QR, Data Matrix, Aztec, PDF417) kullanılabilir."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ================= DIŞA AKTAR ================= -->
                <TabItem Header="Dışa aktar">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                        <StackPanel Margin="2,10,4,10">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Çıktı boyutu" Style="{StaticResource SectionTitle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Genişlik (piksel)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="txtSize" Text="1024"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Çözünürlük (DPI)" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="cmbDpi"/></StackPanel>
                                    </Grid>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="256" Tag="256" Click="SizePreset_Click" Margin="0,0,6,6"/>
                                        <Button Content="512" Tag="512" Click="SizePreset_Click" Margin="0,0,6,6"/>
                                        <Button Content="1024" Tag="1024" Click="SizePreset_Click" Margin="0,0,6,6"/>
                                        <Button Content="2048" Tag="2048" Click="SizePreset_Click" Margin="0,0,6,6"/>
                                        <Button Content="4096" Tag="4096" Click="SizePreset_Click" Margin="0,0,6,6"/>
                                    </WrapPanel>
                                    <CheckBox x:Name="chkSnap" Content="Modülleri tam piksele hizala (keskin kenarlar)" IsChecked="True" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="txtExportInfo" Style="{StaticResource Hint}"/>
                                    <TextBlock Style="{StaticResource FieldLabel}">
                                        <Run Text="JPEG kalitesi: "/><Run Text="{Binding Value, ElementName=sldJpeg, StringFormat=0}"/>
                                    </TextBlock>
                                    <Slider x:Name="sldJpeg" Minimum="50" Maximum="100" Value="95" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Biçim seçerek kaydet" Style="{StaticResource SectionTitle}"/>
                                    <UniformGrid Columns="4">
                                        <Button Content="PNG" Tag="png" Click="ExportFormat_Click" Margin="0,0,6,6" HorizontalAlignment="Stretch"/>
                                        <Button Content="JPG" Tag="jpg" Click="ExportFormat_Click" Margin="0,0,6,6" HorizontalAlignment="Stretch"/>
                                        <Button Content="BMP" Tag="bmp" Click="ExportFormat_Click" Margin="0,0,6,6" HorizontalAlignment="Stretch"/>
                                        <Button Content="TIFF" Tag="tif" Click="ExportFormat_Click" Margin="0,0,6,6" HorizontalAlignment="Stretch"/>
                                        <Button Content="GIF" Tag="gif" Click="ExportFormat_Click" Margin="0,0,6,6" HorizontalAlignment="Stretch"/>
                                        <Button Content="SVG" Tag="svg" Click="ExportFormat_Click" Margin="0,0,6,6" HorizontalAlignment="Stretch"/>
                                        <Button Content="PDF" Tag="pdf" Click="ExportFormat_Click" Margin="0,0,6,6" HorizontalAlignment="Stretch"/>
                                        <Button Content="EPS" Tag="eps" Click="ExportFormat_Click" Margin="0,0,6,6" HorizontalAlignment="Stretch"/>
                                    </UniformGrid>
                                    <TextBlock Style="{StaticResource Hint}" Text="SVG, PDF ve EPS vektörel biçimlerdir; kalite kaybı olmadan ölçeklenir ve baskı için uygundur. PDF/EPS fiziksel boyutu, piksel genişliği ve DPI değerinden hesaplanır."/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button x:Name="btnCopyImage" Content="Görüntüyü panoya kopyala" Margin="0,0,8,0"/>
                                        <Button x:Name="btnCopySvg" Content="SVG kodunu kopyala"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Toplu oluşturma" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Her satır ayrı bir kod olur. Seçili kod türü ve stil kullanılır." Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtBatch" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="110" MaxHeight="220"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <ComboBox x:Name="cmbBatchFormat" SelectedIndex="0">
                                            <ComboBoxItem Content="PNG" Tag="png"/>
                                            <ComboBoxItem Content="JPG" Tag="jpg"/>
                                            <ComboBoxItem Content="SVG" Tag="svg"/>
                                            <ComboBoxItem Content="PDF" Tag="pdf"/>
                                            <ComboBoxItem Content="EPS" Tag="eps"/>
                                            <ComboBoxItem Content="BMP" Tag="bmp"/>
                                            <ComboBoxItem Content="TIFF" Tag="tif"/>
                                            <ComboBoxItem Content="GIF" Tag="gif"/>
                                        </ComboBox>
                                        <CheckBox x:Name="chkBatchNames" Grid.Column="2" Content="Dosya adını içerikten üret" IsChecked="True" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Button x:Name="btnBatch" Content="Klasöre toplu kaydet…" Margin="0,10,0,0" HorizontalAlignment="Left" Style="{DynamicResource AccentButtonStyle}"/>
                                    <TextBlock x:Name="txtBatchStatus" Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- ================= ÖNİZLEME ================= -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,16,16" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="previewHost" ClipToBounds="True">
                        <Border x:Name="previewFrame" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="36"
                                CornerRadius="4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.18"/>
                            </Border.Effect>
                            <Image x:Name="imgPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <Border x:Name="errorBanner" VerticalAlignment="Top" Margin="20" Padding="14,10" CornerRadius="6"
                                Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}" Visibility="Collapsed">
                            <TextBlock x:Name="txtError" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                        </Border>
                    </Grid>
                    <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="18,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock x:Name="txtInfo" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Ellipse x:Name="dotVerify" Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center" Fill="Gray"/>
                                    <TextBlock x:Name="txtVerify" FontSize="12" Text="Doğrulanıyor…" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="btnCopyQuick" Content="Kopyala" Margin="0,0,8,0" ToolTip="Görüntüyü panoya kopyala (Ctrl+C)"/>
                                <Button x:Name="btnSaveAs" Content="Farklı kaydet…" Margin="0,0,8,0" ToolTip="Tüm biçimler (Ctrl+Shift+S)"/>
                                <Button x:Name="btnSavePng" Content="PNG olarak kaydet" Style="{DynamicResource AccentButtonStyle}" ToolTip="Ctrl+S"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
